{
  "manifest_version": 3,
  "name": "Bank Form Autofill",
  "version": "1.0",
  "description": "One-click bubble and hotkey (Alt+F) to fill bank transfer forms.",
  "permissions": ["storage"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Bank Autofill settings" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
